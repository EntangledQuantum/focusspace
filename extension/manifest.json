{
  "manifest_version": 3,
  "name": "FocusSpace",
  "version": "0.9.2",
  "version_name": "0.9.2 beta",
  "description": "Your FocusSpace timer, task and music from the toolbar. Synced live with focusspace.live.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FocusSpace",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://focusspace.live/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "externally_connectable": {
    "matches": [
      "https://focusspace.live/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
