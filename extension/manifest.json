{
  "manifest_version": 3,
  "name": "FocusSpace",
  "version": "0.10.0",
  "version_name": "0.10.0 beta",
  "description": "Your FocusSpace timer, tasks, Focus AI and music in the toolbar and side panel. Synced live with focusspace.live.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FocusSpace",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Open the FocusSpace side panel"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "https://focusspace.live/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://focusspace.live/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
